// Un solo Worker: API e webhook su /api/*, tutto il resto è il pannello
// (file statici di web/out, gratuiti e senza consumo di CPU).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "prenotazioni-ilenia",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // "reale": risponde tramite l'API di Meta; "simulata": scrive le risposte nei log
    "WHATSAPP_MODALITA": "reale",
    "WHATSAPP_GRAPH_VERSION": "v24.0"
  },
  // ogni minuto: scadenze della lista d'attesa e promemoria (il piano gratuito ammette fino a 5 cron)
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
  // Segreti (mai qui dentro): wrangler secret put <NOME>
  //   SUPABASE_URL, SUPABASE_SECRET_KEY,
  //   WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN,
  //   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT, APP_URL,
  //   RESEND_API_KEY, RESEND_FROM
}
