# Nessuna chiave va mai scritta nel codice o committata.
#
# Nel sito vero il pannello NON ha bisogno di variabili: legge indirizzo di
# Supabase e chiavi pubbliche dal Worker (/api/config). Le variabili qui sotto
# con NEXT_PUBLIC_ servono solo in sviluppo (npm run dev → web/.env.local).

# ── Pannello in sviluppo (web/.env.local) ─────────────────────────────
# Supabase → Project Settings → API (o "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chiave pubblica: "publishable" (sb_publishable_…) o la vecchia "anon".
# È pensata per stare nel browser: la sicurezza è garantita dalle regole RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chiave PUBBLICA per le notifiche push (stessa di VAPID_PUBLIC_KEY del Worker).
# Si genera una volta sola con: node strumenti/genera-chiavi-vapid.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Solo se pannello e Worker sono su indirizzi diversi (es. in sviluppo)
# NEXT_PUBLIC_API_URL=http://localhost:8787

# ── Worker Cloudflare (segreti: wrangler secret put, o pannello di Cloudflare) ──
# Li imposta quasi tutti strumenti/messa-online/pubblica.mjs: vedi docs/guida-messa-online.md
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=      # chiave pubblicabile: il Worker la passa al pannello
# SUPABASE_SECRET_KEY=            # chiave segreta (sb_secret_… o service_role): solo nel Worker
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# BOT_OPERATRICE_ID=             # facoltativo: operatrice servita dal numero
# APP_URL=                       # indirizzo del pannello, per i link nelle notifiche
# VAPID_PUBLIC_KEY=              # notifiche push: node strumenti/genera-chiavi-vapid.mjs
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=                 # mailto:tua-email (contatto per i servizi push)
# RESEND_API_KEY=                # email: riserva per Ilenia e promemoria via email
# RESEND_FROM=                   # mittente, es. "Salone Ilenia <prenotazioni@tuodominio.it>"
