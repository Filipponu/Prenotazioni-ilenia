# Copia questo file in web/.env.local e compila i valori.
# Nessuna chiave va mai scritta nel codice o committata.

# ── Pannello (web/.env.local) ─────────────────────────────────────────
# Supabase → Project Settings → API (o "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chiave pubblica: "publishable" (sb_publishable_…) o la vecchia "anon".
# È pensata per stare nel browser: la sicurezza è garantita dalle regole RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Worker Cloudflare (dalla Fase 2, come secret di wrangler) ─────────
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=            # chiave segreta (sb_secret_… o service_role): solo nel Worker
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# RESEND_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
